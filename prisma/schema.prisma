generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String  @id @default(cuid())
  email     String? @unique
  username  String  @unique
  firstName String
  lastName  String
  password  String
  role      Role    @default(SCOUT)

  // Kontaktné + verifikácia (verifikačný flow sa pridá neskôr)
  phone           String?
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?

  // Životný cyklus účtu
  deletedAt   DateTime? // soft delete — deaktivovaný účet
  lastLoginAt DateTime? // nastavuje sa pri každom prihlásení
  note        String? // interná poznámka admina o userovi
  createdAt   DateTime  @default(now())

  ownedLeads   Lead[]     @relation("OwnedLeads")
  lockedLeads  Lead[]     @relation("LockedLeads")
  createdLeads Lead[]     @relation("CreatedLeads")
  activities   Activity[]

  assignedCallLeads  Lead[]          @relation("AssignedCaller")
  handedOffLeads     Lead[]          @relation("HandedOffBy")
  revertedActivities Activity[]      @relation("ActivityRevertedBy")
  tasksRequested     DealTask[]      @relation("DealTaskRequestedBy")
  tasksAssigned      DealTask[]      @relation("DealTaskAssignee")
  tasksClosed        DealTask[]      @relation("DealTaskClosedBy")
  ownershipFrom      DealOwnership[] @relation("DealOwnershipFrom")
  ownershipTo        DealOwnership[] @relation("DealOwnershipTo")
  ownershipBy        DealOwnership[] @relation("DealOwnershipBy")
  requestsRecorded   LeadRequest[]   @relation("LeadRequestRequestedBy")
  requestsResolved   LeadRequest[]   @relation("LeadRequestResolvedBy")

  // Tímy: user je členom max. jedného tímu (teamId) a zároveň môže viesť max. jeden tím (leadsTeam).
  team      Team?   @relation("TeamMembers", fields: [teamId], references: [id])
  teamId    String?
  leadsTeam Team?   @relation("TeamLeader")

  @@index([deletedAt])
  @@index([role])
  @@index([teamId])
}

// Tím = pomenovaná skupina ľudí s jedným vedúcim. Model je zámerne rolovo
// neutrálny: čo vedúci o tíme vidí, určujú jeho práva (SCOUT_LEADER vidí pridané
// kontakty; budúci telesales/spoločný vedúci dostane call práva) – nie typ tímu.
model Team {
  id        String   @id @default(cuid())
  name      String // custom názov, zadá admin
  leader    User?    @relation("TeamLeader", fields: [leaderId], references: [id])
  leaderId  String?  @unique // 1 vedúci = 1 tím; nullable kým nie je priradený
  members   User[]   @relation("TeamMembers")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Invite {
  id          String    @id @default(cuid())
  token       String    @unique
  usedAt      DateTime?
  expiresAt   DateTime
  createdById String? // kto pozývací link vygeneroval
  forEmail    String? // pre koho je určený
  forRole     Role      @default(SCOUT) // aká rola sa priradí po registrácii
}

model Lead {
  id          String  @id @default(cuid())
  number      Int     @unique @default(autoincrement())
  companyName String?
  phone       String?
  website     String?
  email       String?
  note        String?

  status      LeadStatus   @default(NEW)
  origin      LeadOrigin   @default(MARKETING_CALL) // ako sa lead dostal do systému (marketing hovor / priamo / odporúčanie)
  projectType ProjectType? // aký typ projektu klient chce (stránka/eshop/katalóg/webapp…)
  owner       User?        @relation("OwnedLeads", fields: [ownerId], references: [id])
  ownerId     String? // kto to má aktuálne na starosti (N → M)

  // KEDY ĎALEJ – srdce appky
  nextActionKind    NextActionKind?
  nextActionAt      DateTime?
  nextActionHasTime Boolean         @default(false) // true = presný čas; false = len deň
  nextActionMode    NextActionMode  @default(SCHEDULED) // SCHEDULED = termín (urgentnosť); IN_PROGRESS = rozpracované (trvá X dní)
  nextActionNote    String? // "overiť či prišiel mail s návrhom"

  callbackKind    CallbackKind? // prečo je v CALLING fronte
  callbackAt      DateTime? // krátkodobý návrat v /calls (CALLING)
  callbackHasTime Boolean       @default(false) // true = klient dal presný čas; false = len deň
  callbackNote    String? // "vraj sa ozvať o hodinu, bola na porade"

  // KEDY SME ČO POSLALI – presne to, čo si chcel vidieť na prvý pohľad
  quoteSentAt   DateTime? // cenová ponuka
  designSentAt  DateTime? // dizajnový návrh
  designUrl     String?
  aboutUsSentAt DateTime? // info o nás / odpoveď na ich mail

  price          Decimal? @db.Decimal(10, 2) // celková nastrelená cena – tá sa zobrazuje
  priceNote      String? // rozpis/poznámka: "499 stránka + 299 admin systém" – na hover
  priceDisclosed Boolean  @default(false) // klient cenu pozná (ústne aj mailom)

  // ČO KLIENT DOSTAL (round 2, wave 3a) – súhrn platných OFFER_SENT aktivít, vždy prepočítaný (lib/domain/offers.ts).
  // quoteSentAt / aboutUsSentAt / priceDisclosed vyššie sú odvtedy ZMRAZENÉ staré údaje – nový kód ich nezapisuje.
  offerAboutUsAt        DateTime? // prvýkrát „o nás"
  offerPricelistAt      DateTime? // prvýkrát cenník
  offerPriceAt          DateTime? // naposledy konkrétna cena (email aj telefón)
  offerReviewAt         DateTime? // prvýkrát rozbor webu (wave 5, S-17)
  hadLegacySends        Boolean   @default(false) // mal odoslania ešte zo starého systému – nastaví jednorazový krok, potom sa nemení
  legacySendsReviewedAt DateTime? // manažér potvrdil, čo klient zo starého systému naozaj dostal

  lostReason String? // "nemajú záujem", "zlé číslo"

  // kto kontakt pridal – pre štatistiky pridávania
  creator     User?   @relation("CreatedLeads", fields: [createdById], references: [id])
  createdById String?

  // soft delete
  deletedAt DateTime?

  // claim (future-proof, zatiaľ nevyužité)
  lockedBy   User?     @relation("LockedLeads", fields: [lockedById], references: [id])
  lockedById String?
  lockedAt   DateTime?

  // Zodpovednosť za volanie (len fáza volania). null = v spoločnej fronte / mimo fázy volania.
  assignedCaller   User?     @relation("AssignedCaller", fields: [assignedCallerId], references: [id])
  assignedCallerId String?
  assignedCallerAt DateTime? // kedy priradené (audit/poradie, nikdy expirácia)

  // Značka obchodu: createdAt pozitívneho prvého hovoru; maže ju len vrátenie výsledku hovoru.
  pipelineEnteredAt DateTime?
  handedOffBy       User?     @relation("HandedOffBy", fields: [handedOffById], references: [id])
  handedOffById     String? // kto urobil pozitívny hovor
  closedAt          DateTime? // len obchody: WON/LOST/UNREACHABLE; null pri ACTIVE/SNOOZED a mimo obchodov

  revision Int @default(0) // optimistická verzia; +1 presne raz za biznis transakciu

  activities Activity[]
  designs    Design[]
  tasks      DealTask[]
  ownerships DealOwnership[]
  requests   LeadRequest[] // čo klient pýtal (wave 5)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([status])
  @@index([status, callbackKind])
  @@index([deletedAt])
  @@index([createdById, createdAt])
  @@index([status, assignedCallerId, createdAt])
  @@index([assignedCallerId, status, callbackKind])
  @@index([ownerId, status])
  @@index([pipelineEnteredAt, status])
}

enum LeadStatus {
  NEW // pridané, ešte sa nevolalo
  CALLING // ← nový: marketing volá, ešte sa nedovolal
  ACTIVE // rieši sa – všetko medzi prvým hovorom a koncom
  SNOOZED // "ozvite sa o 4 mesiace" – spí, zobudí sa samo
  WON // klient ide do projektu
  LOST // koniec (nezáujem, zlý kontakt, terminované)
  UNREACHABLE // ← nový: zlé číslo / nedá sa spojiť
}

model Activity {
  id        String           @id @default(cuid())
  lead      Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId    String
  user      User             @relation(fields: [userId], references: [id])
  userId    String
  type      ActivityType
  category  ActivityCategory
  source    ActivitySource
  outcome   CallOutcome?
  note      String?
  meta      Json? // štruktúrované detaily: napr. diff zmien { changes: [{ field, from, to }] } alebo verzia trackeru
  createdAt DateTime         @default(now())

  idempotencyKey String?   @unique // klientom generovaný kľúč jedného pokusu o uloženie výsledku
  leadRevision   Int? // len CALL z fronty volaní: Lead.revision po tomto hovore (podmienka vrátenia)
  revertedAt     DateTime? // výsledok tohto hovoru bol vrátený
  revertedBy     User?     @relation("ActivityRevertedBy", fields: [revertedById], references: [id])
  revertedById   String?
  task           DealTask? @relation(fields: [taskId], references: [id]) // udalosť úlohy pre manažéra (wave 3)
  taskId         String?

  // Wave 5: hovor, z ktorého požiadavka vznikla / odoslanie, ktoré ju splnilo (lib/domain/clientRequests.ts).
  requestsSourced  LeadRequest[] @relation("LeadRequestSource")
  requestsResolved LeadRequest[] @relation("LeadRequestResolution")

  @@index([leadId])
  @@index([taskId])
  @@index([userId, createdAt])
  @@index([category, createdAt])
  @@index([source, type, createdAt])
}

enum ActivityType {
  CALL
  QUOTE_SENT
  DESIGN_SENT
  EMAIL_SENT // info o nás, odpoveď, čokoľvek
  SMS_SENT
  NOTE
  NEXT_ACTION_SET
  NEXT_ACTION_CHANGED
  NEXT_ACTION_CLEARED
  CONTACT_UPDATED
  STATUS_CHANGED
  OWNER_CHANGED
  OUTCOME_CORRECTED
  TRACKER_ATTACHED // pripojený tracked link (dizajn/CP)
  TRACKER_UPDATED // nová verzia – „dizajn aktualizovaný"
  TRACKER_OPENED // klient otvoril (míľnik, hlavne po update)
  CALLER_ASSIGNED // audit: manuálny presun práce volajúceho (vlastné nárokovanie sa neloguje)
  CALLER_RELEASED // audit: nárok vrátený do fronty (manažér/deaktivácia)
  CALL_REVERTED // audit: výsledok hovoru vrátený (meta.revertedActivityId)
  DEAL_REOPENED // audit: manažér znovu otvoril uzavretý obchod
  OFFER_SENT // čo klient dostal (o nás / cenník / cena / návrh) – obsah v meta; nahrádza QUOTE_SENT/EMAIL_SENT/DESIGN_SENT
  CLIENT_REPLIED // klient odpísal (email) – kontakt, nie hovor
  TASK_CREATED // úloha pre manažéra (wave 3) – obchodník požiadal
  TASK_MESSAGE // interná správa k otvorenej úlohe (nikdy kontakt s klientom)
  TASK_DONE // manažér úlohu vybavil – výsledok v meta
  TASK_DECLINED // manažér úlohu zamietol s dôvodom
  TASK_CANCELLED // úloha zrušená (vlastník, uzavretie, zmena vlastníka)
  TASK_REASSIGNED // úloha presunutá inému manažérovi
  TASK_RESULT_DISMISSED // vrátený výsledok sa neposiela / berie na vedomie (meta.items + dôvod)
  CLIENT_ASK_CHANGED // wave 5: ručná oprava toho, čo klient pýtal (meta.added / withdrawn / reason)
}

enum CallOutcome {
  NO_ANSWER // 2b nezdvihli
  BAD_NUMBER // 2a zlé číslo
  NOT_INTERESTED // 2c nie
  CALL_AGAIN // 2d "zavolajte mi vtedy a vtedy"
  WANTS_QUOTE // 2e chce CP
  WANTS_DESIGN // 2f chce návrh
  WANTS_EMAIL // 2g máme napísať
  SNOOZE // 2h "o X mesiacov"
  POSITIVE // videli, páči sa, posúva sa to
  WANTS_TO_ORDER // len follow-up: klient chce ísť do toho – obyčajná odpoveď, ďalší krok vyberá obchodník
  INTERESTED // wave 5: dovolali sme sa, majú záujem – ČO chceli, je v LeadRequest riadkoch
}

enum Role {
  SCOUT // pridáva kontakty (vidí len svoje, kým nie sú obvolané)
  SCOUT_LEADER // vedie tím scoutov – vidí ich pridané kontakty, históriu a štatistiky
  TELESALES // prvotné volanie / marketing – rieši calls
  SALES_REP // obchodník: prvé hovory + follow-upy na vlastných obchodoch
  MANAGER // vidí a rieši všetko
  ADMIN // všetko + používatelia, admin stránky
}

enum CallbackKind {
  RETRY // nedovolala sa – skúsiť znova, bez presného času
  SCHEDULED // dohodnutý čas – „pani povedala 15:00"
}

enum ActivityCategory {
  BUSINESS
  PLANNING
  AUDIT
}

enum ActivitySource {
  CALL_QUEUE
  PIPELINE
  CONTACTS
  ADMIN
  CLIENTS // práca vlastníka obchodu bez deals.manage (názov z čias /dashboard/clients); manažér zapisuje PIPELINE
}

enum NextActionKind {
  CALL
  SEND_QUOTE
  SEND_DESIGN
  SEND_EMAIL
  WAITING_FOR_CLIENT
  CUSTOM
}

// Ako interpretovať/zobraziť nextActionAt – nezávislé od kindu:
// SCHEDULED = nextActionAt je termín, ráta sa urgentnosť (future/soon/due/late)
// IN_PROGRESS = rozpracované, nextActionAt je dátum začatia, zobrazí sa „trvá X dní"
enum NextActionMode {
  SCHEDULED
  IN_PROGRESS
}

enum LeadOrigin {
  MARKETING_CALL // klasický flow: marketing volá
  DIRECT // priamy kontakt (stretnutie, sám napísal)
  REFERRAL // odporúčanie
  OTHER
}

enum ProjectType {
  WEBSITE // obyčajná stránka
  ESHOP // eshop s platbou (Shopify)
  CATALOG // katalóg bez platby
  WEBAPP // webová aplikácia
  PORTFOLIO // portfólio
  OTHER // iné (vrátane „chce Zvonček")
}

// ── DIZAJN & TRACKING ────────────────────────────────────────────────────────
// Design = dizajnový návrh (patrí leadu): URL, repo, isLive, verzie, stav poslania.
// DesignVersion = log verzií (v1, v2…), každá môže mať vlastnú URL + poznámku.
// Tracker = sledovanie jedného návrhu (1:1): token + eventy. Token má @unique index,
//   takže ingest API ho nájde JEDNÝM indexovaným dotazom (include aj s návrhom a verziou).
// TrackerEvent = jednotlivé otvorenia/engagement, označkované verziou ktorú videli.

enum TrackedEventType {
  PAGE_VIEW // stránka sa načítala (slabý signál, môže byť skener)
  ENGAGED_VIEW // reálne pozretie (aktívny čas/scroll) – nesie durationMs
}

model Design {
  id             String    @id @default(cuid())
  lead           Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId         String
  label          String? // "Variant A"
  targetUrl      String? // aktuálna URL návrhu (denormalizovaná z poslednej verzie)
  repoUrl        String? // GitHub repo – nech po vypnutí hostingu vieme, ktorý projekt to bol
  isLive         Boolean   @default(true) // ručný príznak: beží stránka? (pri vytvorení predpokladáme áno)
  currentVersion Int       @default(1)
  sentAt         DateTime? // kedy bol návrh prvýkrát poslaný: prepočítané z OFFER_SENT, inak legacySentAt
  legacySentAt   DateTime? // dátum odoslania zo starého systému – skopírovaný jednorazovým krokom, potom sa nemení
  createdById    String?
  deletedAt      DateTime? // soft delete

  versions  DesignVersion[]
  tracker   Tracker?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([leadId])
  @@index([deletedAt])
}

model DesignVersion {
  id          String   @id @default(cuid())
  design      Design   @relation(fields: [designId], references: [id], onDelete: Cascade)
  designId    String
  version     Int // 1, 2, 3…
  url         String? // URL platná pre túto verziu
  note        String? // „opravené čo chcel klient", „zmenené DNS"… alebo nič
  markedAt    DateTime @default(now())
  createdById String?

  events TrackerEvent[]

  @@unique([designId, version])
  @@index([designId])
}

model Tracker {
  id        String   @id @default(cuid())
  token     String   @unique // ingest API ho nájde jedným indexovaným dotazom
  design    Design   @relation(fields: [designId], references: [id], onDelete: Cascade)
  designId  String   @unique // 1:1 s návrhom
  createdAt DateTime @default(now())

  events TrackerEvent[]
}

model TrackerEvent {
  id        String  @id @default(cuid())
  tracker   Tracker @relation(fields: [trackerId], references: [id], onDelete: Cascade)
  trackerId String

  version       DesignVersion? @relation(fields: [versionId], references: [id])
  versionId     String?
  versionAtView Int // ktorú verziu mal klient otvorenú v čase eventu

  type       TrackedEventType
  durationMs Int? // aktívny čas na stránke (ENGAGED_VIEW)
  ip         String? // surová IP – len pre hrubú geolokáciu (nie presná poloha)
  uaShort    String? // hrubý bucket user-agenta (bot heuristika)
  botFlag    Boolean          @default(false)
  occurredAt DateTime         @default(now())

  @@index([trackerId, occurredAt])
  @@index([type, occurredAt])
}

// ── ÚLOHY PRE MANAŽÉRA (wave 3) ──────────────────────────────────────────────
// Obchodník žiada manažéra o cenu / návrh / iné (HELP) alebo o prevzatie klienta (HANDOVER).
// Max. jedna OPEN úloha na obchod – vynútené v príkaze pod zámkom Lead riadku (nie indexom).
// Kým je úloha OPEN, ďalší krok obchodu je zamknutý (odvodené, nič sa neukladá navyše).

enum DealTaskType {
  HELP // cena / návrh / iné
  HANDOVER // obchodník žiada, aby klienta prevzal manažér
}

enum DealTaskContent {
  PRICE
  DESIGN
  OTHER
}

enum DealTaskStatus {
  OPEN
  DONE // vybavené / odovzdanie prijaté
  DECLINED // manažér zamietol s dôvodom
  CANCELLED // vlastník zrušil, alebo skončila s obchodom / zmenou vlastníka
}

model DealTask {
  id            String            @id @default(cuid())
  lead          Lead              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId        String
  type          DealTaskType
  contents      DealTaskContent[] // HELP: aspoň jeden; HANDOVER: prázdne
  status        DealTaskStatus    @default(OPEN)
  text          String // čo sa žiada
  requestedBy   User              @relation("DealTaskRequestedBy", fields: [requestedById], references: [id])
  requestedById String
  assignee      User              @relation("DealTaskAssignee", fields: [assigneeId], references: [id])
  assigneeId    String // manažér, ktorý má konať (dá sa presunúť)
  createdAt     DateTime          @default(now())
  closedAt      DateTime?
  closedBy      User?             @relation("DealTaskClosedBy", fields: [closedById], references: [id])
  closedById    String? // kto ju reálne uzavrel (môže sa líšiť od assignee)
  closeReason   String? // povinné pri DECLINED / CANCELLED
  result        Json? // nemenný záznam výsledku: { price?, designs?, answer? }

  activities Activity[]

  @@index([assigneeId, status, createdAt])
  @@index([leadId, status])
}

// História vlastníctva obchodu (wave 3): každá skutočná zmena vlastníka = jeden riadok v tej istej transakcii.
enum DealOwnershipReason {
  HANDOFF // pozitívny prvý hovor
  CHANGE // manažér zmenil vlastníka
  BULK // hromadný presun
  TAKEOVER // manažér prevzal klienta sám
  HANDOVER // manažér prijal odovzdanie
  REVERT // vrátenie výsledku prvého hovoru
}

// ── ČO KLIENT PÝTAL (wave 5) ─────────────────────────────────────────────────
// Požiadavka je UDALOSŤ s časom, nie trvalá nálepka: klient môže to isté pýtať znova aj po tom, čo to dostal.
// Stav riadku je vždy VÝSLEDOK prepočtu (reconcileRequests, lib/domain/requestMutations.ts) nad požiadavkami
// a platnými OFFER_SENT záznamami – nikdy lokálne prepnutý. Pravidlá: lib/domain/clientRequests.ts.

enum RequestContent {
  INFO // info / ukážky (pošle sa ako ABOUT_US)
  PRICELIST // cenník
  PRICE // konkrétna cena pre tohto klienta
  DESIGN // dizajnový návrh
  REVIEW // rozbor webu
}

enum RequestState {
  OPEN // ešte nedostali
  SENT // splnené platným OFFER_SENT
  WITHDRAWN // už to nechcú (ručne, s dôvodom)
}

enum RequestOrigin {
  LIVE // zaznamenané v aplikácii
  MIGRATED_RECEIPT // odvodené z prevedeného odoslania (§11)
  MIGRATED_OPEN_STEP // odvodené z otvoreného kroku bez odoslania (§11)
}

model LeadRequest {
  id      String         @id @default(cuid())
  lead    Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId  String
  content RequestContent
  state   RequestState   @default(OPEN)
  origin  RequestOrigin  @default(LIVE)

  // Kedy a od koho: „instant" = čas zdrojovej aktivity, nie zaokrúhlený deň.
  requestedAt      DateTime
  requestedBy      User?     @relation("LeadRequestRequestedBy", fields: [requestedById], references: [id])
  requestedById    String? // NULL pri migrovanom riadku bez známeho aktéra – nikdy dnešný vlastník
  source           Activity? @relation("LeadRequestSource", fields: [sourceActivityId], references: [id], onDelete: SetNull)
  sourceActivityId String? // hovor, z ktorého vznikla; vrátenie prvého hovoru riadky zmaže

  // Vyriešenie – prepočítané, nie prepínané
  resolvedAt         DateTime?
  resolvedBy         User?     @relation("LeadRequestResolvedBy", fields: [resolvedById], references: [id])
  resolvedById       String?
  resolution         Activity? @relation("LeadRequestResolution", fields: [resolvedActivityId], references: [id], onDelete: SetNull)
  resolvedActivityId String? // OFFER_SENT, ktoré ju splnilo
  reason             String? // povinný pri ručnom stiahnutí

  // Migrácia (§11)
  migrationKey String? @unique // deterministický kľúč zdroja – opakovaný beh nevytvorí duplikát
  provenance   Json? // zdrojové stĺpce / aktivity, istota, schválená výnimka

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leadId, state])
  @@index([leadId, content, state])
}

model DealOwnership {
  id         String              @id @default(cuid())
  lead       Lead                @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId     String
  fromUser   User?               @relation("DealOwnershipFrom", fields: [fromUserId], references: [id])
  fromUserId String?
  toUser     User?               @relation("DealOwnershipTo", fields: [toUserId], references: [id])
  toUserId   String?
  byUser     User                @relation("DealOwnershipBy", fields: [byUserId], references: [id])
  byUserId   String
  reason     DealOwnershipReason
  note       String?
  createdAt  DateTime            @default(now())

  @@index([leadId, createdAt])
  @@index([fromUserId, createdAt])
}
